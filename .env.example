# Copiá este archivo como .env (no se versiona) y cambiá los valores.
# Docker Compose lo lee solo; para correr los servicios con Maven usá scripts/load-env.ps1

# --- Base de datos de Flight Service ---
FLIGHTS_DB_NAME=flights_db
FLIGHTS_DB_USER=flights_user
FLIGHTS_DB_PASSWORD=cambiar_esta_clave
FLIGHTS_DB_PORT=5433
FLIGHTS_DB_URL=jdbc:postgresql://localhost:5433/flights_db

# --- Base de datos de Reservation Service ---
RESERVATIONS_DB_NAME=reservations_db
RESERVATIONS_DB_USER=reservations_user
RESERVATIONS_DB_PASSWORD=cambiar_esta_clave
RESERVATIONS_DB_PORT=5434
RESERVATIONS_DB_URL=jdbc:postgresql://localhost:5434/reservations_db

# --- Keycloak ---
KEYCLOAK_PORT=8180
# Administrador de la consola de Keycloak (http://localhost:8180)
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=cambiar_esta_clave
# URLs para correr los servicios con Maven en tu máquina (dentro de Docker las pisa docker-compose.yml)
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/aerogest
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/aerogest/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URI=http://localhost:8180/realms/aerogest/protocol/openid-connect/token

# Credencial de servicio de Reservation Service (client credentials) para llamar a /internal/** de Flight Service
RESERVATION_CLIENT_ID=reservation-service
RESERVATION_CLIENT_SECRET=cambiar_este_secreto

# Contraseñas de los usuarios de demostración que crea el realm (admin, user1, user2)
DEMO_ADMIN_PASSWORD=cambiar_esta_clave
DEMO_USER_PASSWORD=cambiar_esta_clave

# --- Integración ---
FLIGHT_SERVICE_BASE_URL=http://localhost:8081
FLIGHT_SERVICE_CONNECT_TIMEOUT_MS=2000
FLIGHT_SERVICE_READ_TIMEOUT_MS=3000


JAVA_TOOL_OPTIONS=-Duser.timezone=UTC